  ],
  "filters": [
    {
      "spec": "warn, app=debug, app::db=trace, app::net=off, noisy",
      "allow": [["warn", "other"], ["debug", "app"], ["debug", "app::sync"], ["trace", "app::db::pool"], ["trace", "noisy::x"]],
      "deny": [["info", "other"], ["trace", "app::sync"], ["error", "app::net"], ["debug", "apparent"]]
    },
    { "spec": "off", "allow": [], "deny": [["fatal", "any"]] },
    { "spec": "", "allow": [["error", "x"], ["fatal", "x"]], "deny": [["warn", "x"]] },
    {
      "spec": "info,com.acme=debug,com.acme.db=off",
      "allow": [["debug", "com.acme.web"], ["info", "org.x"]],
      "deny": [["debug", "org.x"], ["error", "com.acme.db.pool"], ["debug", "com.acmex"]]
    },
    {
      "spec": "warn,web:*=error,app=debug",
      "allow": [["error", "web:api"], ["debug", "app::x"], ["warn", "other"]],
      "deny": [["warn", "web:api"], ["info", "other"]]
    },
    { "spec": "35", "allow": [["warn", "x"]], "deny": [["info", "x"]] },
    { "spec": "info,app=fatal", "allow": [["fatal", "app"]], "deny": [["error", "app"]] },
    { "spec": "info/sync(ed)?", "allow": [["info", "x"]], "deny": [], "messages": { "allow": ["synced 3 files"], "deny": ["idle"] } }
  ]
}
